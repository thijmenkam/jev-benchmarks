{
  "id": "churn_likelihood",
  "name": "Customer churn likelihood",
  "description": "Score how likely a customer account is to churn on a five-level rubric. Labeled with the true risk level (0 = very low, 4 = very high).",
  "primary_question": "churn_risk",
  "questions": {
    "churn_risk": {
      "type": "score",
      "instructions": "How likely is this customer to churn in the next 90 days?",
      "criteria": [
        "Very low risk: actively engaged, renewing, healthy usage",
        "Low risk: engaged but with minor warning signs",
        "Medium risk: noticeable decline in usage or satisfaction",
        "High risk: strong signals of churn intent",
        "Very high risk: already trying to leave"
      ]
    }
  },
  "samples": [
